<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Horner Shelter Investigation - Revised Terrain Model</name>
    <description>Revised terrain model for the Horner Shelter Investigation using supplied CalTopo coordinates, overhang targets, seep line, tactical travel bench, and bounded search polygons.</description>

    <Style id="style-waypoint">
      <IconStyle>
        <scale>1.15</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.9</scale>
      </LabelStyle>
    </Style>

    <Style id="style-overhang">
      <IconStyle>
        <scale>1.25</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/red-stars.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.9</scale>
      </LabelStyle>
    </Style>

    <Style id="style-yellow-line">
      <LineStyle>
        <color>ff00ffff</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <Style id="style-blue-line">
      <LineStyle>
        <color>ffff0000</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <Style id="style-corridor">
      <LineStyle>
        <color>ff00ffff</color>
        <width>2</width>
      </LineStyle>
      <PolyStyle>
        <color>1a00ffff</color>
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
    </Style>

    <Style id="style-bluff-zone">
      <LineStyle>
        <color>ffffff99</color>
        <width>2</width>
      </LineStyle>
      <PolyStyle>
        <color>1aff0000</color>
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
    </Style>



    <Style id="style-gate">
      <IconStyle>
        <scale>1.25</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/orange-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.9</scale>
      </LabelStyle>
    </Style>

    <Style id="style-moore-homestead">
      <IconStyle>
        <scale>1.20</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0.9</scale>
      </LabelStyle>
    </Style>

    <Style id="style-access-line">
      <LineStyle>
        <color>ffaaaaaa</color>
        <width>3</width>
      </LineStyle>
    </Style>

    <Folder>
      <name>Waypoints</name>
    <Placemark>
      <name>UNVERIFIED LEGACY: Spencer Horner Home Site (Baseline: ~1,186 ft)</name>
      <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
      <styleUrl>#style-waypoint</styleUrl>
      <Point>
        <coordinates>-93.49817000,35.66817000,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>UNVERIFIED LEGACY: Spencer Horner Cemetery</name>
      
      <styleUrl>#style-waypoint</styleUrl>
      <Point>
        <coordinates>-93.49550000,35.66217000,0</coordinates>
      </Point>
    <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description></Placemark>
    <Placemark>
      <name>UNVERIFIED LEGACY: Primary Overhang Target A (North)</name>
      <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
      <styleUrl>#style-overhang</styleUrl>
      <Point>
        <coordinates>-93.48930000,35.65885000,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>UNVERIFIED LEGACY: Primary Overhang Target B (South)</name>
      <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
      <styleUrl>#style-overhang</styleUrl>
      <Point>
        <coordinates>-93.48850000,35.65790000,0</coordinates>
      </Point>
    </Placemark>
    </Folder>

    <Folder>
      <name>Access and Context Points</name>
      <Placemark>
        <name>UNVERIFIED LEGACY: Locked Gate / Cable — Primary (Jimmie SSE, Confirmed)</name>
        <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
        <styleUrl>#style-gate</styleUrl>
        <Point>
          <coordinates>-93.48564000,35.66075000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>UNVERIFIED LEGACY: Locked Gate / Cable — Legacy KML Estimate (Discard)</name>
        <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
        <styleUrl>#style-gate</styleUrl>
        <Point>
          <coordinates>-93.49550000,35.64768000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>UNVERIFIED LEGACY: Moore Homestead / Old Moore Place (Approx. Field-Check)</name>
        <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
        <styleUrl>#style-moore-homestead</styleUrl>
        <Point>
          <coordinates>-93.49550000,35.65638000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark>
        <name>UNVERIFIED LEGACY: Access Context Route — Primary Gate to Moore Cemetery (Jimmie SSE)</name>
        <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
        <styleUrl>#style-access-line</styleUrl>
        </Placemark>
    </Folder>

    <Folder>
      <name>Trails and Polylines</name>
    <Placemark>
      <name>UNVERIFIED LEGACY: Tactical Travel Bench (Contour Route)</name>
      <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
      <styleUrl>#style-yellow-line</styleUrl>
      </Placemark>
    <Placemark>
      <name>UNVERIFIED LEGACY: Sandstone/Shale Seep Line</name>
      <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
      <styleUrl>#style-blue-line</styleUrl>
      </Placemark>
    </Folder>

    <Folder>
      <name>Search Corridors and Zones</name>
    <Placemark>
      <name>UNVERIFIED LEGACY: 100m Wide Home-to-Bluff Corridor</name>
      <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
      <styleUrl>#style-corridor</styleUrl>
      </Placemark>
    <Placemark>
      <name>UNVERIFIED LEGACY: Recorded Bluff Search Zone — 300m</name>
      <description>v21 REVIEW: historical location, modern parcel and access rights are unresolved. Not visitor directions. Earlier route/tactical interpretations withdrawn; consult ppan-map.html.</description>
      <styleUrl>#style-bluff-zone</styleUrl>
      </Placemark>
    </Folder>
  </Document>
</kml>